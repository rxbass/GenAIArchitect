        0
      ],
      "id": "cb24a0d0-fb5d-462f-8aac-fb50b22991bf",
      "name": "OpenAI Chat Model",
      "credentials": {
        "openAiApi": {
          "id": "oZ3jyrWHjBeLv6qH",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst output = [];\n\nfor (const item of items) {\n\n  let text = item.json.text;\n\n  // Remove markdown code fences if AI added them\n  text = text\n    .replace(/```json/gi, \"\")\n    .replace(/```/g, \"\")\n    .trim();\n\n  let data;\n\n  try {\n    data = JSON.parse(text);\n  } catch (error) {\n    output.push({\n      json: {\n        error: \"Invalid JSON from AI\",\n        raw_text: text\n      }\n    });\n    continue;\n  }\n\n  // Validate email\n  const email = data.Email\n    ? String(data.Email).trim()\n    : \"\";\n\n  const emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n\n  const emailValid =\n    email !== \"\" &&\n    email.toUpperCase() !== \"INVALID_EMAIL\" &&\n    email.toUpperCase() !== \"MISSING\" &&\n    emailRegex.test(email);\n\n  output.push({\n    json: {\n      Student_ID: data.Student_ID || null,\n      Name: data.Name || null,\n      Email: data.Email || null,\n      Email_Valid: emailValid,\n      Phone: data.Phone || null,\n      Course: data.Course || null,\n      Fee_Paid: data.Fee_Paid ?? null,\n      City: data.City || null,\n      Enrolled_Date: data.Enrolled_Date || null\n    }\n  });\n}\n\nreturn output;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
