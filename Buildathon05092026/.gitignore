# ─────────────────────────────────────────────────────────────
# Kisan Sahayak — .gitignore
# ─────────────────────────────────────────────────────────────

# ── Secrets (NEVER commit) ──
.env
.env.local
*.key



# ── Source corpus IS committed (judges want to see the docs) ──
# data/raw/ is intentionally NOT ignored — the scheme PDFs, HTML,
# and scraped files stay visible in the repo.

# ── Temp audio (STT input / TTS output caches) ──
data/audio_cache/
*.wav
*.mp3
*.tmp

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# ── Virtual environments ──
.venv/
venv/
env/

# ── Tooling caches ──
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# ── Playwright ──
# Browser binaries install to the user cache, not the repo, but ignore
# any local download dirs just in case.
.playwright/

# ── Local model cache (if you point HF cache into the repo) ──
# models/
# .cache/

# ── OS ──
.DS_Store
Thumbs.db

# ── Editor ──
.vscode/
.idea/
*.swp

# ── Logs ──
*.log
logs/

# Markdown files
*.md

# ─────────────────────────────────────────────────────────────
# NOT ignored (kept on purpose):
#   data/raw/         → source scheme documents (the RAG corpus)
#   .claude/skills/   → build-automation skills
#   eval/golden_set.jsonl and eval/results/ → accuracy evidence
# ─────────────────────────────────────────────────────────────
